{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zspan.org/respawn/contracts/seed-manifest.schema.json",
  "title": "Respawn seed manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kernel_version", "project", "paths", "controls"],
  "properties": {
    "kernel_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "country_code", "primary_locale"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "primary_locale": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_profile", "jurisdictions", "governing_bodies", "sources", "meetings", "locales"],
      "properties": {
        "country_profile": { "const": "country/profile.json" },
        "jurisdictions": { "const": "data/jurisdictions.json" },
        "governing_bodies": { "const": "data/governing-bodies.json" },
        "sources": { "const": "data/sources.json" },
        "meetings": { "const": "data/meetings.json" },
        "locales": { "const": "locales" }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_publication_required", "private_person_protection_required", "recipe_registry"],
      "properties": {
        "human_publication_required": { "const": true },
        "private_person_protection_required": { "const": true },
        "recipe_registry": { "const": "sealed_local" }
      }
    }
  }
}
